# =========================================================================
# acbolsa — variáveis de ambiente
# =========================================================================
#
# Copie para `.env.local` e preencha com o projeto Supabase de produção/dev.
# `.env*` está no .gitignore — nada disto é commitado.
#
# As NEXT_PUBLIC_* são embutidas no bundle EM BUILD (`next build`). O container
# recebe as duas primeiras como --build-arg (ver Dockerfile).

# Projeto Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública do site (sem barra no fim). Em produção FIXAR — os links de e-mail
# e o retorno do login com Google precisam bater com o que está registrado no
# Supabase. Em dev local pode deixar vazio (usa o host da requisição).
# Ex.: https://bolsas-next.vercel.app
NEXT_PUBLIC_SITE_URL=

# Login com Google (nativo — popup mostra o domínio do site, não o supabase.co).
# O Client ID do OAuth client "Web application" no Google Cloud
# (termina em .apps.googleusercontent.com). É público.
# O domínio do site precisa estar em "Authorized JavaScript origins" desse client.
# Vazio = botão do Google não aparece.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Pagamento ------------------------------------------------------------
#
# Opção A — Stripe (recomendado). Enquanto STRIPE_SECRET_KEY estiver vazio, o
# checkout usa a opção B ou só registra o pedido.
#   STRIPE_SECRET_KEY        Dashboard → Developers → API keys (sk_live_/sk_test_)
#   STRIPE_WEBHOOK_SECRET    Dashboard → Developers → Webhooks → o endpoint
#                            /api/stripe/webhook → "Signing secret" (whsec_...)
#   SUPABASE_SERVICE_ROLE_KEY  Supabase → Project Settings → API → service_role
#                              (SECRETA — só o webhook usa, para marcar "pago")
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Opção B — link de checkout externo genérico (se não usar Stripe). O código do
# pedido é anexado como ?pedido=AC........
EXTERNAL_CHECKOUT_BASE_URL=
